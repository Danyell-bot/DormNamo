# Copy to .env and fill in. Never commit .env.

# --- Browser (goes into js/app/config.js via `npm run config`) ---
# Maps JavaScript API ONLY. Restrict by HTTP referrer to your site's domains.
GOOGLE_MAPS_BROWSER_KEY=your-browser-key-here
# Map ID for Advanced Markers (colored category pins). DEMO_MAP_ID works for testing.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Deployed nearby-places worker, no trailing slash
NEARBY_API_URL=https://dormnamo-nearby.your-subdomain.workers.dev
# Namo wording by Google Gemini through that worker: on unless set to off (students are asked first)
NAMO_AI=on

# --- Server only (tools/geocode.mjs; on the worker set it with `wrangler secret put`) ---
# Places API (New) + Geocoding API (+ Routes API if ROUTES_MODE is on). Never ship to the browser.
GOOGLE_MAPS_SERVER_KEY=your-server-key-here

# --- Namo AI wording (worker only; set with `npx wrangler secret put GEMINI_API_KEY --config worker/wrangler.toml`) ---
# FREE tier only: create it in Google AI Studio in a Google Cloud project with NO billing account,
# so Google cannot charge anything. Free-tier content may be used by Google to improve its products.
GEMINI_API_KEY=your-gemini-key-here
